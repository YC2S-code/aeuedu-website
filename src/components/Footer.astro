---
import { getEntry } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { getLocalePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const settings = await getEntry('settings', `${lang}/site`);
const { siteName, tagline, footer } = settings!.data;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <h3>{siteName}</h3>
        <p>{tagline}</p>
      </div>

      <div>
        <h3>{lang === 'zh' ? '社交媒体' : 'Social Media'}</h3>
        <p>
          {footer.facebook && <a href={footer.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>}
          {footer.facebook && <br />}
          {footer.youtube && <a href={footer.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>}
          {footer.youtube && <br />}
          {footer.tiktok && <a href={footer.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>}
          {footer.tiktok && <br />}
          {footer.wechat && <span>{lang === 'zh' ? '微信：' : 'WeChat: '}{footer.wechat}</span>}
        </p>
        {footer.wechatQr && (
          <div class="site-footer__qr">
            <img src={footer.wechatQr} alt={lang === 'zh' ? '微信公众号二维码' : 'WeChat Official Account QR Code'} width="100" height="100" loading="lazy" />
            <span>{lang === 'zh' ? '扫码关注公众号' : 'Scan to follow on WeChat'}</span>
          </div>
        )}
      </div>

      <div>
        <h3>{lang === 'zh' ? '课程咨询' : 'Program Inquiry'}</h3>
        <p>
          <a href={getLocalePath(lang, 'programs/emba')}>{lang === 'zh' ? 'EMBA 高级工商管理硕士' : 'EMBA'}</a><br />
          <a href={getLocalePath(lang, 'programs/pep')}>{lang === 'zh' ? '专业高管课程 PEP' : 'PEP'}</a><br />
          <a href={getLocalePath(lang, 'contact')}>{lang === 'zh' ? '在线咨询' : 'Enquire Now'}</a>
        </p>
      </div>

      <div>
        <h3>{lang === 'zh' ? '联系亚欧' : 'Contact AEU'}</h3>
        <p>{footer.address}</p>
        <p>
          <a href={`tel:${footer.phone.replace(/\s+/g, '')}`}>{footer.phone}</a><br />
          <a href={`mailto:${footer.email}`}>{footer.email}</a>
        </p>
      </div>

      {footer.mapEmbedUrl && (
        <div>
          <h3>{lang === 'en' ? 'Find Us' : '地图位置'}</h3>
          <iframe src={footer.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      )}
    </div>

    <div class="site-footer__bottom">
      {footer.disclaimer && <p class="site-footer__disclaimer">{footer.disclaimer}</p>}
      <p>{footer.copyright}</p>
    </div>
  </div>
</footer>
