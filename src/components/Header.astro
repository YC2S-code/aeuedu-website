---
import { getCollection, getEntry } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { getLocalePath, otherLang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const _siteEntry = await getEntry('settings', 'site');
  const settings = _siteEntry!.data[lang as 'en' | 'zh'];
const currentPath = Astro.url.pathname;

// Nav children are driven entirely by CMS pages with a `parent` field set.
// URL = /lang/parent/slug, where slug strips a leading "<parent>-" prefix from
// the filename so "alumni-network.md" becomes /alumni/network, not /alumni/alumni-network.
const allPages = await getCollection('pages', (entry) => entry.data.published);
const navPagesByParent = new Map<string, { href: string; label: string }[]>();
for (const entry of allPages) {
  const [entryLang, ...rest] = entry.id.split('/');
  if (entryLang !== lang || !entry.data.parent) continue;
  const basename = rest.join('/');
  const pageSlug = basename.replace(new RegExp(`^${entry.data.parent}-`), '');
  const list = navPagesByParent.get(entry.data.parent) ?? [];
  list.push({
    href: getLocalePath(lang, `${entry.data.parent}/${pageSlug}`),
    label: entry.data.navLabel || entry.data.title,
  });
  navPagesByParent.set(entry.data.parent, list);
}

const other = otherLang(lang);
// Swap the locale prefix while keeping the rest of the path
const otherPath = currentPath.replace(`/${lang}`, `/${other}`) || `/${other}`;
const enHref = lang === 'en' ? currentPath : otherPath;
const zhHref = lang === 'zh' ? currentPath : otherPath;

type NavLink = {
  href: string;
  label: string;
  children?: NavLink[];
};

// Top-level sections are fixed; their children come entirely from CMS pages.
// "Latest News" and "Contact" are the only hardcoded children because they
// point to dedicated Astro pages that aren't content-collection entries.
const links: (NavLink & { key?: string })[] = [
  {
    key: 'programs',
    href: getLocalePath(lang, 'programs'),
    label: lang === 'zh' ? '课程项目' : 'Programs',
  },
  {
    key: 'faculty',
    href: getLocalePath(lang, 'faculty'),
    label: lang === 'zh' ? '教授/企业咨询' : 'Faculty & Consulting',
  },
  {
    key: 'alumni',
    href: getLocalePath(lang, 'alumni'),
    label: lang === 'zh' ? '亚欧人' : 'Alumni',
  },
  {
    key: 'impact',
    href: getLocalePath(lang, 'impact'),
    label: lang === 'zh' ? '影响力' : 'Impact',
  },
  {
    key: 'news',
    href: getLocalePath(lang, 'news'),
    label: lang === 'zh' ? '活动/新闻' : 'News & Events',
    children: [
      { href: getLocalePath(lang, 'news'), label: lang === 'zh' ? '最新动态' : 'Latest News' },
    ],
  },
  {
    key: 'about',
    href: getLocalePath(lang, 'about'),
    label: lang === 'zh' ? '我的亚欧' : 'About AEU',
    children: [
      { href: getLocalePath(lang, 'contact'), label: lang === 'zh' ? '联系' : 'Contact' },
    ],
  },
];

// Populate each section's children from CMS pages tagged with that parent
for (const link of links) {
  const cms = link.key ? navPagesByParent.get(link.key) : undefined;
  if (cms?.length) {
    link.children = [...cms, ...(link.children ?? [])];
  }
}

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={getLocalePath(lang, '')} class="site-header__brand">
      <img src="/images/branding/aeu-logo.png" alt={settings.siteName} class="site-header__logo" />
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-drawer">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>

  <div class="nav-overlay" id="nav-overlay"></div>

  <div class="nav-drawer" id="nav-drawer">
    <nav class="nav-drawer__nav" aria-label="Main navigation">
      <ul class="nav-drawer__list">
        {links.map((link) => (
          <li class="nav-drawer__item">
            <div class="nav-drawer__row">
              <a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
              {link.children && (
                <button class="nav-drawer__caret" aria-expanded="false" aria-label="Expand submenu">
                  <span class="nav-drawer__chevron"></span>
                </button>
              )}
            </div>
            {link.children && (
              <ul class="nav-drawer__submenu">
                {link.children.map((child) => (
                  <li class="nav-drawer__item">
                    <div class="nav-drawer__row">
                      <a href={child.href} class={isActive(child.href) ? 'active' : ''}>{child.label}</a>
                      {child.children && (
                        <button class="nav-drawer__caret" aria-expanded="false" aria-label="Expand submenu">
                          <span class="nav-drawer__chevron"></span>
                        </button>
                      )}
                    </div>
                    {child.children && (
                      <ul class="nav-drawer__submenu nav-drawer__submenu--sub">
                        {child.children.map((grandchild) => (
                          <li>
                            <a href={grandchild.href} class={isActive(grandchild.href) ? 'active' : ''}>{grandchild.label}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <div class="lang-switch">
        <a href={zhHref} class={lang === 'zh' ? 'active' : ''}>中文</a>
        <a href={enHref} class={lang === 'en' ? 'active' : ''}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const overlay = document.getElementById('nav-overlay');

  function closeDrawer() {
    drawer?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.classList.remove('is-active');
    document.body.classList.remove('nav-open');
  }

  function openDrawer() {
    drawer?.classList.add('is-open');
    overlay?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.classList.add('is-active');
    document.body.classList.add('nav-open');
  }

  toggle?.addEventListener('click', () => {
    if (drawer?.classList.contains('is-open')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  overlay?.addEventListener('click', closeDrawer);

  document.querySelectorAll('.nav-drawer__caret').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.nav-drawer__item');
      const submenu = item?.querySelector(':scope > .nav-drawer__submenu');
      const isOpen = submenu?.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(!!isOpen));
    });
  });

  // Top-level nav items are menu groupings rather than standalone pages,
  // so clicking the label expands its submenu instead of navigating away.
  document.querySelectorAll('.nav-drawer__list > .nav-drawer__item > .nav-drawer__row').forEach((row) => {
    const link = row.querySelector('a');
    const caret = row.querySelector('.nav-drawer__caret');
    if (link && caret) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        (caret as HTMLElement).click();
      });
    }
  });
</script>
