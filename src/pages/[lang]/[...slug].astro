---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../i18n/utils';

export async function getStaticPaths() {
  const slugs = [
    'programs',
    'programs/emba',
    'programs/pep',
    'programs/pep/open',
    'programs/pep/custom',
    'faculty',
    'faculty/professors',
    'faculty/lecturers',
    'faculty/consulting',
    'alumni',
    'alumni/network',
    'alumni/stories',
    'impact',
    'impact/national-strategy',
    'impact/esg',
    'follow-us',
    'about',
    'about/stories',
    'about/research-center',
    'about/investment-center',
  ];

  const knownIds = new Set(
    ['en', 'zh'].flatMap((lang) => slugs.map((slug) => `${lang}/${slug.replace(/\//g, '-')}`)),
  );

  const knownPaths = ['en', 'zh'].flatMap((lang) =>
    slugs.map((slug) => ({ params: { lang, slug }, props: { entryId: `${lang}/${slug.replace(/\//g, '-')}` } })),
  );

  // Pages created in the CMS that aren't part of the fixed nested routes above
  // get a flat route based on their filename slug, e.g. /en/my-new-page/
  const allPages = await getCollection('pages');
  const extraPaths = allPages
    .filter((entry) => !knownIds.has(entry.id))
    .map((entry) => {
      const [lang, ...rest] = entry.id.split('/');
      return { params: { lang, slug: rest.join('/') }, props: { entryId: entry.id } };
    });

  return [...knownPaths, ...extraPaths];
}

const { lang } = Astro.params as { lang: Lang };
const { entryId } = Astro.props as { entryId: string };
const entry = await getEntry('pages', entryId);
const { Content } = await render(entry!);
---

<Layout lang={lang} title={entry!.data.title}>
  <div class:list={['page-header', { 'page-header--has-image': entry!.data.image }]} style={entry!.data.image ? `--page-header-image: url(${entry!.data.image})` : undefined}>
    <div class="container">
      <h1>{entry!.data.title}</h1>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Layout>
