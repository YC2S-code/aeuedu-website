---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../i18n/utils';

export async function getStaticPaths() {
  const allPages = await getCollection('pages');
  return allPages.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    const basename = rest.join('/');
    // Pages with parent get URL /lang/parent/slug.
    // Strip leading "<parent>-" prefix from basename if present (handles legacy
    // filenames like alumni-network.md → alumni/network).
    const urlSlug = entry.data.parent
      ? `${entry.data.parent}/${basename.replace(new RegExp(`^${entry.data.parent}-`), '')}`
      : basename;
    return { params: { lang, slug: urlSlug }, props: { entryId: entry.id } };
  });
}

const { lang } = Astro.params as { lang: Lang };
const { entryId } = Astro.props as { entryId: string };
const entry = await getEntry('pages', entryId);
const { Content } = await render(entry!);
---

<Layout lang={lang} title={entry!.data.title}>
  <div class:list={['page-header', { 'page-header--has-image': entry!.data.image }]} style={entry!.data.image ? `--page-header-image: url(${entry!.data.image})` : undefined}>
    <div class="container">
      <h1>{entry!.data.title}</h1>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Layout>
