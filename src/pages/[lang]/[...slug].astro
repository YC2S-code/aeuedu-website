---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../i18n/utils';

export async function getStaticPaths() {
  const allPages = await getCollection('pages', (entry) => entry.data.published);
  return allPages.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    const basename = rest.join('/');
    // Pages with parent get URL /lang/parent/slug.
    // Strip leading "<parent>-" prefix from basename if present (handles legacy
    // filenames like alumni-network.md → alumni/network).
    const urlSlug = entry.data.parent
      ? `${entry.data.parent}/${basename.replace(new RegExp(`^${entry.data.parent}-`), '')}`
      : basename;
    return { params: { lang, slug: urlSlug }, props: { entryId: entry.id } };
  });
}

const { lang } = Astro.params as { lang: Lang };
const { entryId } = Astro.props as { entryId: string };
const entry = await getEntry('pages', entryId);
const { Content } = await render(entry!);

function youtubeEmbedUrl(url: string): string | null {
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : null;
}

function bilibiliEmbedUrl(url: string): string | null {
  const m = url.match(/bilibili\.com\/video\/(BV[A-Za-z0-9]+)/);
  return m ? `https://player.bilibili.com/player.html?bvid=${m[1]}&autoplay=0` : null;
}

const videoUrl = lang === 'zh'
  ? (entry!.data.videoBilibili ? bilibiliEmbedUrl(entry!.data.videoBilibili) : (entry!.data.videoYoutube ? youtubeEmbedUrl(entry!.data.videoYoutube) : null))
  : (entry!.data.videoYoutube ? youtubeEmbedUrl(entry!.data.videoYoutube) : (entry!.data.videoBilibili ? bilibiliEmbedUrl(entry!.data.videoBilibili) : null));
---

<Layout lang={lang} title={entry!.data.title}>
  {entry!.data.image && (
    <div class="page-banner">
      <img src={entry!.data.image} alt={entry!.data.title} class="page-banner__img" />
    </div>
  )}
  <div class="page-header">
    <div class="container">
      <h1>{entry!.data.title}</h1>
    </div>
  </div>
  <section class="section">
    <div class="container">
      {videoUrl && (
        <div class="embed-responsive" style="max-width: 760px; margin-bottom: 2rem;">
          <iframe src={videoUrl} allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" />
        </div>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Layout>
