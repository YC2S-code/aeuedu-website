---
import { getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import type { Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  const slugs = ['history-mission', 'leadership', 'facilities'];
  return ['en', 'zh'].flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const entry = await getEntry('pages', `${lang}/about-${slug}`);
const { Content } = await render(entry!);
---

<Layout lang={lang} title={entry!.data.title}>
  <div class="page-header">
    <div class="container">
      <h1>{entry!.data.title}</h1>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Layout>
