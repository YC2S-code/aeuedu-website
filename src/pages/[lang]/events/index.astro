---
import { marked } from 'marked';
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getLangEntries, slugFromId, DEFAULT_ARTICLE_IMAGE } from '../../../lib/content';
import { useTranslations, getLocalePath, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-US';
const events = (await getLangEntries('events', lang)).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const _siteEntry = await getEntry('settings', 'site');
  const settings = _siteEntry!.data[lang as 'en' | 'zh'];
const bannerImage = settings.banners?.events;
---

<Layout lang={lang} title={t('page.events.title')}>
  <div class:list={['page-header', { 'page-header--has-image': bannerImage }]} style={bannerImage ? `--page-header-image: url(${bannerImage})` : undefined}>
    <div class="container">
      <h1>{t('page.events.title')}</h1>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {events.map((event) => (
          <div class="card">
            <img class="card__image" src={event.data.image ?? DEFAULT_ARTICLE_IMAGE} alt={event.data.title} />
            <div class="card__body">
              <span class="badge">{event.data.category ?? t('label.category.event')}</span>
              <div class="card__meta">
                {event.data.date.toLocaleDateString(dateLocale)}
                {event.data.location ? ` · ${event.data.location}` : ''}
              </div>
              <h3>{event.data.title}</h3>
              <p set:html={marked.parseInline(event.data.summary)} />
              <a href={getLocalePath(lang, `events/${slugFromId(event.id)}`)}>{t('action.learnMore')}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
