---
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import { getLangEntries, slugFromId } from '../../lib/content';
import { useTranslations, getLocalePath, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const settings = await getEntry('settings', `${lang}/site`);
const { siteName, tagline, home } = settings!.data;

const news = (await getLangEntries('news', lang)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const events = (await getLangEntries('events', lang)).sort((a, b) => a.data.date.getTime() - b.data.date.getTime()).slice(0, 2);

const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-US';

const highlights = home.highlights ?? [];
---

<Layout lang={lang} title={siteName} description={tagline}>
  <section class="hero" style={home.heroImage ? `--hero-image: url(${home.heroImage})` : undefined}>
    <div class="container">
      <h1>{home.heroTitle}</h1>
      <p>{home.heroSubtitle}</p>
      <a class="btn btn-primary" href={getLocalePath(lang, 'programs')}>{home.heroCta}</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{home.highlightsTitle}</h2>
      <div class="grid grid-3">
        {highlights.map((h) => (
          <div class="card">
            <div class="card__body">
              <h3>{h.title}</h3>
              <p set:html={marked.parseInline(h.text)} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t('section.latestNews')}</h2>
      <div class="grid grid-3">
        {news.map((article) => (
          <div class="card">
            {article.data.image && <img class="card__image" src={article.data.image} alt={article.data.title} />}
            <div class="card__body">
              <div class="card__meta">{article.data.date.toLocaleDateString(dateLocale)}</div>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
              <a href={getLocalePath(lang, `news/${slugFromId(article.id)}`)}>{t('action.readMore')}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">{t('section.upcomingEvents')}</h2>
      <div class="grid grid-3">
        {events.map((event) => (
          <div class="card">
            {event.data.image && <img class="card__image" src={event.data.image} alt={event.data.title} />}
            <div class="card__body">
              <div class="card__meta">{event.data.date.toLocaleDateString(dateLocale)}{event.data.location ? ` · ${event.data.location}` : ''}</div>
              <h3>{event.data.title}</h3>
              <p>{event.data.summary}</p>
              <a href={getLocalePath(lang, `events/${slugFromId(event.id)}`)}>{t('action.learnMore')}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
