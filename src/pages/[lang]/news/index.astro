---
import { marked } from 'marked';
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getLangEntries, slugFromId, estimateReadingTime, DEFAULT_ARTICLE_IMAGE, newsCategoryLabel } from '../../../lib/content';
import { useTranslations, getLocalePath, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-US';
const news = (await getLangEntries('news', lang)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const _siteEntry = await getEntry('settings', 'site');
  const settings = _siteEntry!.data[lang as 'en' | 'zh'];
const bannerImage = settings.banners?.news;
---

<Layout lang={lang} title={t('page.news.title')}>
  <div class:list={['page-header', { 'page-header--has-image': bannerImage }]} style={bannerImage ? `--page-header-image: url(${bannerImage})` : undefined}>
    <div class="container">
      <h1>{t('page.news.title')}</h1>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {news.map((article) => (
          <div class="card">
            <img class="card__image" src={article.data.image ?? DEFAULT_ARTICLE_IMAGE} alt={article.data.title} />
            <div class="card__body">
              <span class="badge">{newsCategoryLabel(t, article.data.category)}</span>
              <div class="card__meta">
                {article.data.date.toLocaleDateString(dateLocale)} · {estimateReadingTime(article.body ?? '', lang)} {t('label.minRead')}
              </div>
              <h3>{article.data.title}</h3>
              <p set:html={marked.parseInline(article.data.summary)} />
              <a href={getLocalePath(lang, `news/${slugFromId(article.id)}`)}>{t('action.readMore')}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
