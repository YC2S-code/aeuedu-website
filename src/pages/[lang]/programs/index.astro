---
import Layout from '../../../layouts/Layout.astro';
import { getLangEntries, slugFromId } from '../../../lib/content';
import { useTranslations, getLocalePath, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const programs = (await getLangEntries('programs', lang)).sort((a, b) => a.data.order - b.data.order);
---

<Layout lang={lang} title={t('page.programs.title')} description={t('page.programs.intro')}>
  <div class="page-header">
    <div class="container">
      <h1>{t('page.programs.title')}</h1>
      <p>{t('page.programs.intro')}</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {programs.map((program) => (
          <div class="card">
            {program.data.image && <img class="card__image" src={program.data.image} alt={program.data.title} />}
            <div class="card__body">
              <h3>{program.data.title}</h3>
              <p>{program.data.summary}</p>
              <a href={getLocalePath(lang, `programs/${slugFromId(program.id)}`)}>{t('action.learnMore')}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
