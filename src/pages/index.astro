<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/zh/" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/zh/" />
    <title>Redirecting to: /zh/</title>
    <script is:inline>
      // Preserve any URL fragment (e.g. Netlify Identity recovery/confirmation
      // tokens) when redirecting, since the meta refresh above would drop it.
      window.location.replace('/zh/' + window.location.hash);
    </script>
  </head>
  <body>
    <a href="/zh/">Redirecting from <code>/</code> to <code>/zh/</code></a>
  </body>
</html>
